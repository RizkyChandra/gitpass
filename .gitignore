# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/.kotlin/
# The Go core is a 17MB binary artifact — build it with `just aar`, don't commit it.
android/app/libs/*.aar
android/app/libs/*.jar
!android/app/libs/.gitkeep

# Signing material. Never commit these: the keystore is the app's identity and
# losing control of it lets anyone ship an update your users will trust.
*.jks
*.keystore
android/keystore.properties
